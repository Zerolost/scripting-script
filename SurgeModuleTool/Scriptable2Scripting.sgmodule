#!name=Scriptable 链接转 Scripting
#!desc=v4：MITM scripthub.vercel.app（官方）与 script.hub（镜像），改写 scriptable:// 并去掉 target=_blank。
#!arguments=hosts:scripthub.vercel.app, script.hub
#!arguments-desc=需要拦截的域名，逗号分隔；默认是官方站与镜像站。
#!requirement=CORE_VERSION>=20

[Body Rewrite]
http-response ^https?:// scriptable:///run_single/ scripting://run_single/ scriptable:///run/ scripting://run/ scriptable:/// scripting:// scriptable:// scripting://
http-response ^https?:// (:href="[^"]*SurgeModuleTool[^"]*")\s+target="_blank" $1

[Header Rewrite]
http-response ^https?:// header-replace-regex Location scriptable:/// scripting://

[MITM]
hostname = %APPEND% {{{hosts}}}
skip-server-cert-verify = %APPEND% script.hub
