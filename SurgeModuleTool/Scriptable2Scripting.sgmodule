#!name=Scriptable 链接转 Scripting
#!desc=仅在常见脚本分发站点把 scriptable:// 改写为 scripting://，避免全局 MITM。
#!requirement=CORE_VERSION>=20

[Body Rewrite]
http-response ^https?://(script-hub\.netlify\.app|raw\.githubusercontent\.com|gist\.githubusercontent\.com|github\.com|gist\.github\.com|[^/]+\.github\.io)/ scriptable:///run_single/ scripting://run_single/ scriptable:///run/ scripting://run/ scriptable:/// scripting:// scriptable:// scripting://

[Header Rewrite]
http-response ^https?://(script-hub\.netlify\.app|raw\.githubusercontent\.com|gist\.githubusercontent\.com|github\.com|gist\.github\.com|[^/]+\.github\.io)/ header-replace-regex Location scriptable:/// scripting://

[MITM]
hostname = %APPEND% script-hub.netlify.app, raw.githubusercontent.com, gist.githubusercontent.com, github.com, gist.github.com, *.github.io
