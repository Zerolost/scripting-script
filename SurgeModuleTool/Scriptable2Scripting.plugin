#!name=Scriptable 链接转 Scripting
#!desc=v9：只 MITM scripthub.vercel.app。把 scriptable:// 安装链接改写为 scripting://，并用响应脚本给 Loon/Stash/Shadowrocket 的远程导入按钮各加一个“本地模块”按钮，原有远程按钮保持不变。
#!author=Scripting

[Rewrite]
# scriptable:// → scripting://
^https?://scripthub\.vercel\.app/ response-body-replace-regex scriptable:///run_single/ scripting://run_single/
^https?://scripthub\.vercel\.app/ response-body-replace-regex scriptable:///run/ scripting://run/
^https?://scripthub\.vercel\.app/ response-body-replace-regex scriptable:/// scripting://
^https?://scripthub\.vercel\.app/ response-body-replace-regex scriptable:// scripting://
# 去掉 target="_blank"，否则 iOS Safari 会在新标签页里打开自定义协议
^https?://scripthub\.vercel\.app/ response-body-replace-regex (:href="[^"]*SurgeModuleTool[^"]*")\s+target="_blank" $1
^https?://scripthub\.vercel\.app/ response-body-replace-regex (:href="[^"]*openloon/import\?plugin=[^"]*")\s+target="_blank" $1
^https?://scripthub\.vercel\.app/ response-body-replace-regex (:href="[^"]*install-override\?url=[^"]*")\s+target="_blank" $1
^https?://scripthub\.vercel\.app/ response-body-replace-regex (:href="[^"]*shadowrocket/install\?module=[^"]*")\s+target="_blank" $1
# 按钮文案作为生效标记
^https?://scripthub\.vercel\.app/ response-body-replace-regex Scriptable\)</a> Scripting)</a>
# 响应头
^https?://scripthub\.vercel\.app/ response-header-replace-regex Location scriptable:/// scripting://

[Script]
http-response ^https?://scripthub\.vercel\.app/ script-path=https://raw.githubusercontent.com/Zerolost/scripting-script/main/SurgeModuleTool/local-module.js,tag=ScriptHubLocalModule,requires-body=true,timeout=10,enable=true

[MITM]
hostname = scripthub.vercel.app
