#!name=Scriptable 链接转 Scripting
#!desc=把 scriptable:// 安装链接改写为 scripting://，并给 Shadowrocket 的远程导入按钮旁加一个“本地模块”按钮
#!requirement=CORE_VERSION>=20

[Body Rewrite]
http-response ^https?://scripthub\.vercel\.app/ scriptable:///run_single/ scripting://run_single/ scriptable:///run/ scripting://run/ scriptable:/// scripting:// scriptable:// scripting://
http-response ^https?://scripthub\.vercel\.app/ (:href="[^"]*ModuleDock[^"]*")\s+target="_blank" $1
http-response ^https?://scripthub\.vercel\.app/ (:href="[^"]*openloon/import\?plugin=[^"]*")\s+target="_blank" $1
http-response ^https?://scripthub\.vercel\.app/ (:href="[^"]*install-override\?url=[^"]*")\s+target="_blank" $1
http-response ^https?://scripthub\.vercel\.app/ (:href="[^"]*shadowrocket/install\?module=[^"]*")\s+target="_blank" $1
http-response ^https?://scripthub\.vercel\.app/ Scriptable\)</a> Scripting)</a>

[Script]
ScriptHubLocalModule = type=http-response,pattern=^https?://scripthub\.vercel\.app/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Zerolost/scripting-script/main/ModuleDock/local-module.js

[Header Rewrite]
http-response ^https?://scripthub\.vercel\.app/ header-replace-regex Location scriptable:/// scripting://

[MITM]
hostname = %APPEND% scripthub.vercel.app
